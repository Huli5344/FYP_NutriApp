@echo off
REM ---------------------------------------------------------------------------
REM Run the app against Gemini DIRECTLY, with a key compiled in.
REM
REM YOU PROBABLY DO NOT NEED THIS ANY MORE. The key now lives on the Flask
REM backend and the app calls /api/chat, so a plain
REM
REM     flutter run
REM
REM builds an app whose assistant works and whose APK contains no secret.
REM That is the normal way to run it, and the way to build anything you hand
REM to somebody else.
REM
REM This script is for working on the chat itself with no server running, or
REM against a backend that has no key set. It makes the app talk to Google
REM directly instead.
REM
REM Copy it to run_app.bat, paste your own key, and run it from the nutriapp
REM folder. run_app.bat is in .gitignore; this .example file is not.
REM
REM SECURITY: a key passed this way is COMPILED INTO THE APK and can be
REM extracted by anyone who has the file. Never build a release this way. The
REM key for the deployed app belongs in Render's environment variables, where
REM the server reads it and the app never sees it.
REM ---------------------------------------------------------------------------

REM Get a key from https://aistudio.google.com/apikey
set GEMINI_API_KEY=paste-your-key-here

REM Check the model name against Google's current list before changing it.
REM A name that does not exist fails with a 404 that NutriBot reports as
REM "Model ... was not found".
set GEMINI_MODEL=gemini-3.5-flash-lite

flutter run ^
  --dart-define=GEMINI_API_KEY=%GEMINI_API_KEY% ^
  --dart-define=GEMINI_MODEL=%GEMINI_MODEL%
